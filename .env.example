# JXM Forms — stores every enquiry, spam-filters it and emails it to Omega
# through Resend with any uploaded plans/photos attached. Required.
# Key: jxm-forms dashboard -> Clients -> Omega Construction -> Settings.
JXM_FORMS_API_KEY=

# Overrides for testing against a local jxm-forms dev server:
# JXM_FORMS_URL=http://localhost:3000/api/submit/omega-construction
# JXM_FORMS_UPLOADS_URL=http://localhost:3000/api/submit/omega-construction/uploads
